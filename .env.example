NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SMS_DRY_RUN=true
# Supabase Edge Function secrets only (never configure in Vercel/browser):
SUPABASE_SERVICE_ROLE_KEY=configure-with-supabase-secrets
REMINDER_CRON_SECRET=configure-with-a-long-random-value
REMINDER_ALERT_WEBHOOK_URL=https://alerts.example.invalid/reminder-runs
TWILIO_ACCOUNT_SID=configure-with-supabase-secrets
TWILIO_AUTH_TOKEN=configure-with-supabase-secrets
TWILIO_FROM_NUMBER=+351000000000
BOOTSTRAP_VET_EMAIL=vet@example.invalid
