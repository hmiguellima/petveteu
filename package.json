{
  "name": "petveteu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20.18.0 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:admin": "node scripts/verify-admin-clients.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "libphonenumber-js": "^1.11.7",
    "next": "^14.2.13",
    "next-intl": "^3.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.13",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2",
    "vitest": "^2.0.5"
  }
}
